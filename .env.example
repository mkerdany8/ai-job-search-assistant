# Copy this file to the repo root as .env and fill in your own keys.
# Never commit .env.

# OpenRouter, used for all LLM generation and chat completion calls.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Tavily, used by the web search tool for company research and
# for looking up specifics when triaging resume gaps.
# https://tavily.com
TAVILY_API_KEY=
